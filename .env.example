# Postgres container (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wnba
# POSTGRES_PORT=5433   # uncomment if 5432 is already taken on this machine

# connection used by the ETL load
# - running in Docker: host "db"
# - running locally with uv: host "localhost" (and the port above)
WNBA_PG_URL=postgresql://postgres:change-me@db:5432/wnba
